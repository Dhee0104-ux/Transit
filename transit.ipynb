def create_sample_data():
    """Create sample stops, routes, trips, and stop-time data."""

    rng = np.random.default_rng(42)

    stop_rows = []
    route_rows = []
    trip_rows = []
    stop_time_rows = []

    center_lat = 17.385
    center_lon = 78.486

    num_stops = 35
    num_routes = 8

    for i in range(num_stops):
        stop_rows.append({
            "stop_id": f"S{i+1}",
            "stop_name": f"Sample Bus Stop {i+1}",
            "stop_lat": center_lat + rng.uniform(-0.07, 0.07),
            "stop_lon": center_lon + rng.uniform(-0.07, 0.07)
        })

    for r in range(num_routes):
        route_id = f"R{r+1}"

        route_rows.append({
            "route_id": route_id,
            "route_short_name": f"Route {r+1}",
            "route_long_name": f"Sample Route {r+1}",
            "route_type": "3"
        })

        chosen_stops = rng.choice(
            [f"S{i+1}" for i in range(num_stops)],
            size=8,
            replace=False
        )

        trip_id = f"T{r+1}"
        trip_rows.append({
            "route_id": route_id,
            "service_id": "WEEKDAY",
            "trip_id": trip_id
        })

        for seq, stop_id in enumerate(chosen_stops, start=1):
            hour = 6 + (seq // 3)
            minute = (seq * 8) % 60

            stop_time_rows.append({
                "trip_id": trip_id,
                "arrival_time": f"{hour:02d}:{minute:02d}:00",
                "departure_time": f"{hour:02d}:{minute:02d}:00",
                "stop_id": stop_id,
                "stop_sequence": seq
            })

    return {
        "stops": pd.DataFrame(stop_rows),
        "routes": pd.DataFrame(route_rows),
        "trips": pd.DataFrame(trip_rows),
        "stop_times": pd.DataFrame(stop_time_rows),
        "shapes": None,
        "ridership": None
    }


