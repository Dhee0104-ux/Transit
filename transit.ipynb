# -------------------- 5. FILE-READING HELPERS --------------------

def find_file_recursive(directory, filename):
    """Find a file even if it is inside a nested folder."""

    for root, dirs, filenames in os.walk(directory):
        for name in filenames:
            if name.lower() == filename.lower():
                return os.path.join(root, name)

    return None


def read_gtfs_file(filename, required=True):
    """Read a GTFS text file from the extracted ZIP folder."""

    path = find_file_recursive(DATA_DIR, filename)

    if path is None:
        if required:
            raise FileNotFoundError(
                f"Required GTFS file '{filename}' was not found."
            )
        return None

    return pd.read_csv(path, dtype=str)


def normalize_columns(df):
    """Make column names consistent."""

    if df is None:
        return None

    df = df.copy()
    df.columns = [
        str(col).strip().lower().replace(" ", "_")
        for col in df.columns
    ]

    return df


def find_excel_sheet(excel_file, possible_names):
    """Find an Excel sheet using common sheet-name variations."""

    sheet_map = {
        str(name).strip().lower().replace(" ", "_"): name
        for name in excel_file.sheet_names
    }

    for name in possible_names:
        key = name.lower().replace(" ", "_")
        if key in sheet_map:
            return pd.read_excel(excel_file, sheet_name=sheet_map[key])

    return None


def load_excel_workbook(filepath):
    """
    Load an Excel workbook.

    Recommended sheets:
      stops: stop_id, stop_name, stop_lat, stop_lon
      routes: route_id, route_short_name, route_long_name
      trips: route_id, trip_id, service_id
      stop_times: trip_id, stop_id, stop_sequence, arrival_time
      ridership: date, route_id, passengers

    A single-sheet workbook containing stop coordinates is also supported.
    """

    excel_file = pd.ExcelFile(filepath)

    stops = find_excel_sheet(
        excel_file, ["stops", "bus_stops", "stop"]
    )

    routes = find_excel_sheet(
        excel_file, ["routes", "bus_routes", "route"]
    )

    trips = find_excel_sheet(
        excel_file, ["trips", "trip"]
    )

    stop_times = find_excel_sheet(
        excel_file, ["stop_times", "stoptimes", "timetable"]
    )

    shapes = find_excel_sheet(
        excel_file, ["shapes", "route_shapes"]
    )

    ridership = find_excel_sheet(
        excel_file, ["ridership", "passenger_data", "demand"]
    )

    # If no stops sheet was found, use the first sheet.
    if stops is None:
        stops = pd.read_excel(
            excel_file,
            sheet_name=excel_file.sheet_names[0]
        )

    result = {
        "stops": normalize_columns(stops),
        "routes": normalize_columns(routes),
        "trips": normalize_columns(trips),
        "stop_times": normalize_columns(stop_times),
        "shapes": normalize_columns(shapes),
        "ridership": normalize_columns(ridership)
    }

    return result


def load_zip_gtfs(filepath):
    """Extract a GTFS ZIP and load its standard files."""

    shutil.rmtree(DATA_DIR, ignore_errors=True)
    os.makedirs(DATA_DIR, exist_ok=True)

    with zipfile.ZipFile(filepath, "r") as z:
        bad_file = z.testzip()

        if bad_file:
            raise ValueError(
                f"The ZIP file appears damaged: {bad_file}"
            )

        z.extractall(DATA_DIR)

    stops = read_gtfs_file("stops.txt")
    routes = read_gtfs_file("routes.txt")
    trips = read_gtfs_file("trips.txt", required=False)
    stop_times = read_gtfs_file("stop_times.txt", required=False)
    shapes = read_gtfs_file("shapes.txt", required=False)

    # GTFS generally does not include passenger counts.
    ridership = None

    return {
        "stops": normalize_columns(stops),
        "routes": normalize_columns(routes),
        "trips": normalize_columns(trips),
        "stop_times": normalize_columns(stop_times),
        "shapes": normalize_columns(shapes),
        "ridership": ridership
    }


# -------------------- 6. DATA CLEANING ---------------------------

def clean_stops(stops):
    """Clean bus-stop information."""

    if stops is None:
        raise ValueError("A stops dataset is required.")

    stops = normalize_columns(stops)

    # Support common column-name alternatives.
    rename_map = {
        "latitude": "stop_lat",
        "lat": "stop_lat",
        "longitude": "stop_lon",
        "lon": "stop_lon",
        "lng": "stop_lon",
        "id": "stop_id",
        "name": "stop_name"
    }

    for old, new in rename_map.items():
        if old in stops.columns and new not in stops.columns:
            stops = stops.rename(columns={old: new})

    required = ["stop_lat", "stop_lon"]

    for col in required:
        if col not in stops.columns:
            raise ValueError(
                f"Stops data must contain '{col}'. "
                "Use latitude/longitude or stop_lat/stop_lon."
            )

    if "stop_id" not in stops.columns:
        stops["stop_id"] = [
            f"STOP_{i+1}" for i in range(len(stops))
        ]

    if "stop_name" not in stops.columns:
        stops["stop_name"] = stops["stop_id"]

    stops["stop_lat"] = pd.to_numeric(
        stops["stop_lat"], errors="coerce"
    )

    stops["stop_lon"] = pd.to_numeric(
        stops["stop_lon"], errors="coerce"
    )

    stops = stops.dropna(subset=["stop_lat", "stop_lon"])

    # Remove impossible latitude/longitude values.
    stops = stops[
        stops["stop_lat"].between(-90, 90)
        & stops["stop_lon"].between(-180, 180)
    ]

    stops = stops.drop_duplicates(subset=["stop_id"])

    return stops.reset_index(drop=True)


def clean_routes(routes):
    """Clean route information."""

    if routes is None:
        return pd.DataFrame(columns=[
            "route_id", "route_short_name", "route_long_name"
        ])

    routes = normalize_columns(routes)

    if "route_id" not in routes.columns:
        if "id" in routes.columns:
            routes = routes.rename(columns={"id": "route_id"})
        else:
            routes["route_id"] = [
                f"ROUTE_{i+1}" for i in range(len(routes))
            ]

    if "route_short_name" not in routes.columns:
        routes["route_short_name"] = routes["route_id"]

    if "route_long_name" not in routes.columns:
        routes["route_long_name"] = routes["route_short_name"]

    return routes.drop_duplicates(
        subset=["route_id"]
    ).reset_index(drop=True)


def clean_trips(trips):
    if trips is None:
        return None

    trips = normalize_columns(trips)

    if "trip_id" not in trips.columns:
        return None

    return trips


def clean_stop_times(stop_times):
    if stop_times is None:
        return None

    stop_times = normalize_columns(stop_times)

    if "stop_sequence" in stop_times.columns:
        stop_times["stop_sequence"] = pd.to_numeric(
            stop_times["stop_sequence"], errors="coerce"
        )

    return stop_times


# -------------------- 7. DISTANCE CALCULATION --------------------

def haversine_km(lat1, lon1, lat2, lon2):
    """Calculate the distance between two GPS coordinates."""

    earth_radius_km = 6371.0

    lat1, lon1, lat2, lon2 = map(
        np.radians, [lat1, lon1, lat2, lon2]
    )

    dlat = lat2 - lat1
    dlon = lon2 - lon1

    a = (
        np.sin(dlat / 2) ** 2
        + np.cos(lat1) * np.cos(lat2) * np.sin(dlon / 2) ** 2
    )

    return 2 * earth_radius_km * np.arcsin(
        np.sqrt(np.clip(a, 0, 1))
    )


def route_distance_from_stops(route_stops):
    """Estimate a route's length by joining its stop coordinates."""

    route_stops = route_stops.dropna(
        subset=["stop_lat", "stop_lon"]
    )

    if len(route_stops) < 2:
        return 0.0

    distance = 0.0

    for i in range(1, len(route_stops)):
        previous = route_stops.iloc[i - 1]
        current = route_stops.iloc[i]

        distance += haversine_km(
            previous["stop_lat"],
            previous["stop_lon"],
            current["stop_lat"],
            current["stop_lon"]
        )

    return float(distance)


# -------------------- 8. ROUTE-STOP CONNECTIONS ------------------

def build_route_stop_table(data):
    """
    Connect route IDs to stop IDs using trips and stop_times.

    GTFS relationship:
    routes -> trips -> stop_times -> stops
    """

    routes = data["routes"]
    trips = data["trips"]
    stop_times = data["stop_times"]
    stops = data["stops"]

    if (
        trips is not None
        and stop_times is not None
        and "route_id" in trips.columns
        and "trip_id" in trips.columns
        and "trip_id" in stop_times.columns
        and "stop_id" in stop_times.columns
    ):
        merged = stop_times.merge(
            trips[["trip_id", "route_id"]].drop_duplicates(),
            on="trip_id",
            how="left"
        )

        merged = merged.merge(
            stops[["stop_id", "stop_lat", "stop_lon", "stop_name"]],
            on="stop_id",
            how="left"
        )

        if "stop_sequence" in merged.columns:
            merged = merged.sort_values(
                ["route_id", "trip_id", "stop_sequence"]
            )

        return merged

    # Excel alternative: a route_stops sheet.
    # It should contain route_id and stop_id.
    route_stops = data.get("route_stops")

    if route_stops is not None:
        route_stops = normalize_columns(route_stops)

        if {"route_id", "stop_id"}.issubset(route_stops.columns):
            return route_stops.merge(
                stops,
                on="stop_id",
                how="left"
            )

    # If the workbook contains route_id directly in the stops sheet.
    if "route_id" in stops.columns:
        return stops.copy()

    return pd.DataFrame()


# -------------------- 9. RIDERSHIP DATA --------------------------

def create_sample_ridership(routes, days=180):
    """Create illustrative passenger data for demonstration."""

    rng = np.random.default_rng(21)

    route_ids = routes["route_id"].astype(str).tolist()

    if not route_ids:
        route_ids = ["SAMPLE_ROUTE"]

    dates = pd.date_range(
        end=pd.Timestamp.today().normalize(),
        periods=days,
        freq="D"
    )

    rows = []

    for route_index, route_id in enumerate(route_ids):
        base = rng.integers(100, 800)

        for i, date in enumerate(dates):
            weekday_factor = 1.15 if date.dayofweek < 5 else 0.75
            trend = 1 + (i / max(days, 1)) * 0.1
            noise = rng.normal(1, 0.12)

            passengers = max(
                0,
                int(base * weekday_factor * trend * noise)
            )

            rows.append({
                "date": date,
                "route_id": str(route_id),
                "passengers": passengers
            })

    return pd.DataFrame(rows)


def clean_ridership(ridership, routes):
    """Standardize passenger-count data."""

    if ridership is None:
        if USE_SAMPLE_RIDERSHIP:
            print(
                "No ridership file detected. "
                "Using illustrative synthetic passenger data."
            )
            return create_sample_ridership(routes)

        return None

    ridership = normalize_columns(ridership)

    rename_map = {
        "passenger_count": "passengers",
        "ridership": "passengers",
        "count": "passengers",
        "date_time": "date",
        "travel_date": "date",
        "route": "route_id"
    }

    for old, new in rename_map.items():
        if old in ridership.columns and new not in ridership.columns:
            ridership = ridership.rename(columns={old: new})

    required = ["date", "route_id", "passengers"]

    if not set(required).issubset(ridership.columns):
        print(
            "Ridership data must contain date, route_id, passengers. "
            "Using sample ridership instead."
        )

        if USE_SAMPLE_RIDERSHIP:
            return create_sample_ridership(routes)

        return None

    ridership["date"] = pd.to_datetime(
        ridership["date"], errors="coerce"
    )

    ridership["route_id"] = ridership["route_id"].astype(str)

    ridership["passengers"] = pd.to_numeric(
        ridership["passengers"], errors="coerce"
    )

    ridership = ridership.dropna(
        subset=["date", "route_id", "passengers"]
    )

    ridership = ridership[ridership["passengers"] >= 0]

    return ridership.reset_index(drop=True)


# -------------------- 10. DEMAND FORECASTING ---------------------

def forecast_demand(ridership, forecast_days=7):
    """
    Train a Random Forest model using date and route information.
    Forecasts are illustrative if the input ridership is synthetic.
    """

    if ridership is None or ridership.empty:
        return None, None

    df = ridership.copy()

    df["date"] = pd.to_datetime(df["date"])
    df["route_id"] = df["route_id"].astype(str)

    # Aggregate duplicate daily records.
    df = (
        df.groupby(["date", "route_id"], as_index=False)
        ["passengers"].sum()
    )

    route_categories = sorted(df["route_id"].unique())

    route_mapping = {
        route: index for index, route in enumerate(route_categories)
    }

    df["route_code"] = df["route_id"].map(route_mapping)
    df["day_of_week"] = df["date"].dt.dayofweek
    df["month"] = df["date"].dt.month
    df["day_of_year"] = df["date"].dt.dayofyear
    df["is_weekend"] = (df["day_of_week"] >= 5).astype(int)

    features = [
        "route_code",
        "day_of_week",
        "month",
        "day_of_year",
        "is_weekend"
    ]

    X = df[features]
    y = df["passengers"]

    model = RandomForestRegressor(
        n_estimators=150,
        random_state=42,
        min_samples_leaf=2
    )

    metrics = {}

    if len(df) >= 10:
        # Split chronologically across the entire dataset.
        ordered = df.sort_values(
            ["date", "route_id"]
        ).reset_index(drop=True)

        split_index = max(1, int(len(ordered) * 0.8))

        train = ordered.iloc[:split_index]
        test = ordered.iloc[split_index:]

        if len(test) > 0 and len(train) >= 2:
            evaluation_model = RandomForestRegressor(
                n_estimators=100,
                random_state=42,
                min_samples_leaf=2
            )

            evaluation_model.fit(
                train[features], train["passengers"]
            )

            predictions = evaluation_model.predict(test[features])

            metrics["MAE"] = mean_absolute_error(
                test["passengers"], predictions
            )

            metrics["RMSE"] = np.sqrt(
                mean_squared_error(
                    test["passengers"], predictions
                )
            )

    model.fit(X, y)

    last_date = df["date"].max()
    future_dates = pd.date_range(
        start=last_date + pd.Timedelta(days=1),
        periods=forecast_days,
        freq="D"
    )

    forecast_rows = []

    for route_id in route_categories:
        for date in future_dates:
            row = pd.DataFrame([{
                "route_code": route_mapping[route_id],
                "day_of_week": date.dayofweek,
                "month": date.month,
                "day_of_year": date.dayofyear,
                "is_weekend": int(date.dayofweek >= 5)
            }])

            predicted = max(
                0,
                float(model.predict(row[features])[0])
            )

            forecast_rows.append({
                "date": date,
                "route_id": route_id,
                "predicted_passengers": round(predicted)
            })

    return pd.DataFrame(forecast_rows), metrics


# -------------------- 11. UNDERSERVED AREA DETECTION -------------

def detect_underserved_areas(stops, route_stop_table, grid_size=0.02):
    """
    Approximate underserved areas using geographic stop density.

    This is a proximity-based indicator, not a full accessibility model.
    """

    if stops.empty:
        return pd.DataFrame()

    points = stops[["stop_lat", "stop_lon"]].dropna().copy()

    if len(points) < 3:
        return pd.DataFrame()

    # Approximate local grid in latitude/longitude.
    points["lat_cell"] = (
        np.floor(points["stop_lat"] / grid_size) * grid_size
    )

    points["lon_cell"] = (
        np.floor(points["stop_lon"] / grid_size) * grid_size
    )

    grid = (
        points.groupby(["lat_cell", "lon_cell"])
        .size()
        .reset_index(name="stop_count")
    )

    # Cells with zero stops cannot be identified from stop points alone.
    # Flag cells with comparatively few stops.
    threshold = max(
        1,
        int(grid["stop_count"].quantile(0.25))
    )

    grid["status"] = np.where(
        grid["stop_count"] <= threshold,
        "Potentially underserved",
        "More stop coverage"
    )

    return grid[grid["status"] == "Potentially underserved"]


# -------------------- 12. MAP GENERATION -------------------------

def create_stop_map(stops):
    """Create an interactive map of all bus stops."""

    center = [
        stops["stop_lat"].mean(),
        stops["stop_lon"].mean()
    ]

    m = folium.Map(
        location=center,
        zoom_start=12,
        tiles="OpenStreetMap"
    )

    for _, row in stops.iterrows():
        folium.CircleMarker(
            location=[row["stop_lat"], row["stop_lon"]],
            radius=4,
            popup=(
                f"<b>{row['stop_name']}</b><br>"
                f"Stop ID: {row['stop_id']}"
            ),
            tooltip=str(row["stop_name"]),
            color="blue",
            fill=True,
            fill_opacity=0.75
        ).add_to(m)

    return m


def create_route_map(stops, route_stop_table, routes):
    """Draw routes by connecting their stops in sequence."""

    center = [
        stops["stop_lat"].mean(),
        stops["stop_lon"].mean()
    ]

    m = folium.Map(
        location=center,
        zoom_start=12,
        tiles="OpenStreetMap"
    )

    for _, row in stops.iterrows():
        folium.CircleMarker(
            location=[row["stop_lat"], row["stop_lon"]],
            radius=3,
            popup=str(row["stop_name"]),
            color="gray",
            fill=True
        ).add_to(m)

    if route_stop_table.empty:
        folium.Marker(
            location=center,
            popup="No route-stop connections were found."
        ).add_to(m)

        return m

    route_table = route_stop_table.copy()

    if "route_id" not in route_table.columns:
        return m

    if "stop_sequence" in route_table.columns:
        route_table = route_table.sort_values(
            ["route_id", "stop_sequence"]
        )

    for route_id, group in route_table.groupby("route_id"):
        group = group.dropna(
            subset=["stop_lat", "stop_lon"]
        )

        if len(group) < 2:
            continue

        coordinates = list(zip(
            group["stop_lat"],
            group["stop_lon"]
        ))

        folium.PolyLine(
            coordinates,
            weight=4,
            opacity=0.75,
            tooltip=f"Route {route_id}"
        ).add_to(m)

    return m


# -------------------- 13. ROUTE ANALYSIS -------------------------

def calculate_route_statistics(route_stop_table, routes):
    """Calculate route stop counts and approximate distances."""

    if route_stop_table.empty:
        return pd.DataFrame(columns=[
            "route_id", "stop_count", "estimated_distance_km"
        ])

    route_table = route_stop_table.copy()

    if "route_id" not in route_table.columns:
        return pd.DataFrame()

    if "stop_sequence" in route_table.columns:
        route_table = route_table.sort_values(
            ["route_id", "stop_sequence"]
        )

    results = []

    for route_id, group in route_table.groupby("route_id"):
        # Use a single ordered trip when trip IDs are available.
        if "trip_id" in group.columns:
            trip_groups = list(
                group.dropna(subset=["trip_id"]).groupby("trip_id")
            )

            if trip_groups:
                group = max(
                    [g for _, g in trip_groups],
                    key=len
                )

        group = group.drop_duplicates(
            subset=["stop_id"]
        ) if "stop_id" in group.columns else group

        results.append({
            "route_id": str(route_id),
            "stop_count": len(group),
            "estimated_distance_km": round(
                route_distance_from_stops(group), 2
            )
        })

    stats = pd.DataFrame(results)

    if not routes.empty:
        stats = stats.merge(
            routes,
            on="route_id",
            how="left"
        )

    return stats


# -------------------- 14. JOURNEY TIME ESTIMATION ---------------

def estimate_journey_time(distance_km, average_speed_kmh=20):
    """
    Estimate journey time from distance and average speed.

    This does not account for live traffic, waiting time, or transfers.
    """

    if average_speed_kmh <= 0:
        return None

    hours = distance_km / average_speed_kmh
    minutes = hours * 60

    return round(minutes, 1)


# -------------------- 15. DASHBOARD AND EXPORTS ------------------

def render_dashboard(data):
    """Render all analysis results and export downloadable files."""

    stops = data["stops"]
    routes = data["routes"]
    ridership = data["ridership"]
    route_stop_table = data["route_stop_table"]

    print("\n" + "=" * 65)
    print("TRANSITLENS — PUBLIC TRANSPORT ANALYTICS DASHBOARD")
    print("=" * 65)

    print(f"\nCity / dataset: {CITY_NAME}")
    print(f"Number of stops: {len(stops):,}")
    print(f"Number of routes: {len(routes):,}")

    if ridership is not None:
        print(f"Ridership records: {len(ridership):,}")

    # ---------- Route statistics ----------
    route_stats = calculate_route_statistics(
        route_stop_table, routes
    )

    print("\nROUTE PERFORMANCE")
    display(route_stats.head(20))

    # ---------- Stop map ----------
    print("\nBUS STOP MAP")

    stop_map = create_stop_map(stops)
    stop_map_path = os.path.join(
        OUTPUT_DIR, "bus_stop_map.html"
    )

    stop_map.save(stop_map_path)
    display(stop_map)

    # ---------- Route map ----------
    print("\nROUTE MAP")

    route_map = create_route_map(
        stops, route_stop_table, routes
    )

    route_map_path = os.path.join(
        OUTPUT_DIR, "route_map.html"
    )

    route_map.save(route_map_path)
    display(route_map)

    # ---------- Route distance chart ----------
    if not route_stats.empty:
        if "route_short_name" in route_stats.columns:
            route_stats["display_name"] = (
                route_stats["route_short_name"].fillna(
                    route_stats["route_id"]
                )
            )
        else:
            route_stats["display_name"] = route_stats["route_id"]

        fig = px.bar(
            route_stats,
            x="display_name",
            y="estimated_distance_km",
            title="Estimated Route Distance (km)",
            labels={
                "display_name": "Route",
                "estimated_distance_km": "Distance (km)"
            }
        )

        fig.show()

    # ---------- Ridership charts and forecasts ----------
    forecast, metrics = forecast_demand(ridership)

    if ridership is not None and not ridership.empty:
        daily_demand = (
            ridership.groupby("date", as_index=False)
            ["passengers"].sum()
        )

        fig = px.line(
            daily_demand,
            x="date",
            y="passengers",
            title="Historical Daily Passenger Demand",
            labels={
                "date": "Date",
                "passengers": "Passengers"
            }
        )

        fig.show()

    if forecast is not None and not forecast.empty:
        print("\n7-DAY PASSENGER DEMAND FORECAST")
        display(forecast)

        fig = px.line(
            forecast,
            x="date",
            y="predicted_passengers",
            color="route_id",
            markers=True,
            title="Predicted Passenger Demand — Next 7 Days",
            labels={
                "date": "Date",
                "predicted_passengers": "Predicted passengers",
                "route_id": "Route"
            }
        )

        fig.show()

        if metrics:
            print("\nMODEL EVALUATION")
            for metric, value in metrics.items():
                print(f"{metric}: {value:.2f}")

    # ---------- Underserved areas ----------
    underserved = detect_underserved_areas(
        stops, route_stop_table
    )

    print("\nPOTENTIALLY UNDERSERVED STOP-AREA CELLS")
    display(underserved.head(30))

    if not underserved.empty:
        underserved_map = folium.Map(
            location=[
                stops["stop_lat"].mean(),
                stops["stop_lon"].mean()
            ],
            zoom_start=11
        )

        for _, row in underserved.iterrows():
            folium.Circle(
                location=[
                    row["lat_cell"],
                    row["lon_cell"]
                ],
                radius=700,
                popup=(
                    "Potentially underserved area<br>"
                    f"Stops in cell: {row['stop_count']}"
                ),
                color="red",
                fill=True,
                fill_opacity=0.2
            ).add_to(underserved_map)

        for _, row in stops.iterrows():
            folium.CircleMarker(
                location=[
                    row["stop_lat"],
                    row["stop_lon"]
                ],
                radius=2,
                color="blue"
            ).add_to(underserved_map)

        underserved_path = os.path.join(
            OUTPUT_DIR, "underserved_areas.html"
        )

        underserved_map.save(underserved_path)
        display(underserved_map)

    # ---------- Journey-time estimate ----------
    print("\nJOURNEY TIME ESTIMATE")

    if not route_stats.empty:
        journey = route_stats.copy()

        journey["estimated_time_minutes"] = (
            journey["estimated_distance_km"].apply(
                estimate_journey_time
            )
        )

        display(journey[[
            "route_id",
            "estimated_distance_km",
            "estimated_time_minutes"
        ]].head(20))

    # ---------- Save CSVs ----------
    stops.to_csv(
        os.path.join(OUTPUT_DIR, "cleaned_stops.csv"),
        index=False
    )

    routes.to_csv(
        os.path.join(OUTPUT_DIR, "cleaned_routes.csv"),
        index=False
    )

    route_stats.to_csv(
        os.path.join(OUTPUT_DIR, "route_statistics.csv"),
        index=False
    )

    if ridership is not None:
        ridership.to_csv(
            os.path.join(OUTPUT_DIR, "ridership_data.csv"),
            index=False
        )

    if forecast is not None:
        forecast.to_csv(
            os.path.join(OUTPUT_DIR, "demand_forecast.csv"),
            index=False
        )

    underserved.to_csv(
        os.path.join(OUTPUT_DIR, "underserved_areas.csv"),
        index=False
    )

    # ---------- Export stop coordinates as GeoJSON ----------
    features = []

    for _, row in stops.iterrows():
        features.append({
            "type": "Feature",
            "geometry": {
                "type": "Point",
                "coordinates": [
                    float(row["stop_lon"]),
                    float(row["stop_lat"])
                ]
            },
            "properties": {
                "stop_id": str(row["stop_id"]),
                "stop_name": str(row["stop_name"])
            }
        })

    geojson = {
        "type": "FeatureCollection",
        "features": features
    }

    with open(
        os.path.join(OUTPUT_DIR, "bus_stops.geojson"),
        "w",
        encoding="utf-8"
    ) as f:
        json.dump(geojson, f, indent=2)

    # ---------- Package all outputs ----------
    zip_path = shutil.make_archive(
        "/content/TransitLens_Results",
        "zip",
        OUTPUT_DIR
    )

    print("\n" + "=" * 65)
    print("ANALYSIS COMPLETED")
    print("=" * 65)

    print("\nYour output files are saved in:")
    print(OUTPUT_DIR)

    print("\nDownloading the results ZIP...")
    files.download(zip_path)


# -------------------- 16. MAIN LOADING WORKFLOW ------------------

def run_transitlens(_):
    with status_output:
        clear_output()

        print("Preparing TransitLens...")

        try:
            selected_format = format_choice.value

            # Step 1: Choose the selected data source.
            if selected_format == "sample":
                print("Creating sample dataset...")
                data = create_sample_data()

            elif selected_format == "zip":
                print("Please upload your GTFS ZIP file.")

                uploaded = files.upload()

                zip_files = [
                    name for name in uploaded
                    if name.lower().endswith(".zip")
                ]

                if not zip_files:
                    raise ValueError(
                        "No ZIP file was uploaded. "
                        "Choose a .zip GTFS dataset."
                    )

                data = load_zip_gtfs(zip_files[0])

            elif selected_format == "excel":
                print("Please upload your Excel workbook.")

                uploaded = files.upload()

                excel_files = [
                    name for name in uploaded
                    if name.lower().endswith((".xlsx", ".xls"))
                ]

                if not excel_files:
                    raise ValueError(
                        "No Excel file was uploaded. "
                        "Choose an .xlsx or .xls workbook."
                    )

                data = load_excel_workbook(excel_files[0])

            else:
                raise ValueError("Please select a valid data format.")

            # Step 2: Clean the loaded data.
            print("\nCleaning the data...")

            data["stops"] = clean_stops(data["stops"])
            data["routes"] = clean_routes(data["routes"])
            data["trips"] = clean_trips(data.get("trips"))
            data["stop_times"] = clean_stop_times(
                data.get("stop_times")
            )

            # Step 3: Build route-stop connections.
            data["route_stop_table"] = build_route_stop_table(data)

            # Step 4: Prepare ridership.
            data["ridership"] = clean_ridership(
                data.get("ridership"),
                data["routes"]
            )

            # Step 5: Show results.
            print("\nData loaded successfully.")
            print(f"Stops: {len(data['stops'])}")
            print(f"Routes: {len(data['routes'])}")

            render_dashboard(data)

        except Exception as e:
            print("\nERROR")
            print(str(e))

            print(
                "\nCheck that your file matches the selected format "
                "and contains the required columns."
            )


load_button.on_click(run_transitlens)

print(
    "\nSelect ZIP, Excel, or sample data above, "
    "then click 'Choose Data and Render'."
)
